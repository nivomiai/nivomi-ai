# Copy to .env.local (git-ignored) and fill in. Never commit real values or paste them in chat.

# ── Exotel (India account) ────────────────────────────────────────────────
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# India cluster: api.in.exotel.com · Singapore cluster: api.exotel.com (use the one in your console)
EXOTEL_API_HOST=api.in.exotel.com
# Your ExoPhone, as shown in the Exotel console
EXOTEL_CALLER_ID=
# Only for transfer tests: the App Bazaar flow ID of "Voicebot applet → Connect applet (phone B)"
EXOTEL_FLOW_APP_ID=

# ── Sarvam ────────────────────────────────────────────────────────────────
SARVAM_API_KEY=
# saaras:v3-realtime (default) or saaras:v4-realtime
SARVAM_STT_MODEL=saaras:v3-realtime
# transcribe | codemix | verbatim  (applied to final transcripts)
SARVAM_STT_MODE=transcribe
# bulbul:v3 (default) or bulbul:v2
SARVAM_TTS_MODEL=bulbul:v3
# Lowercase bulbul:v3 speaker, e.g. shubh, ritu, priya, kavya, anand
SARVAM_TTS_SPEAKER=shubh

# ── LLM (any OpenAI-compatible Chat Completions endpoint) ─────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Exact model ID from your provider console (no default on purpose)
LLM_MODEL=

# ── Spike runtime ─────────────────────────────────────────────────────────
PORT=8080
# Public HTTPS URL of your tunnel to PORT, e.g. https://xyz.trycloudflare.com
PUBLIC_BASE_URL=
# Long random string; guards the public endpoints. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SPIKE_STREAM_TOKEN=
# Team members' own phones (E.164). The spike refuses to call any other number.
SPIKE_TEST_PHONE_A=
SPIKE_TEST_PHONE_B=
# Hard cap per call, seconds
SPIKE_MAX_CALL_SECONDS=240
