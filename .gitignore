# ── Secrets & environment ──────────────────────────────────────────────
# Only *.env.example files may be committed. Everything else is local or
# injected by the deployment platform's secret manager.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Keys, certificates, credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
secrets/
.secrets/

# Customer / production data must never enter Git
*.dump
*.sql.gz
*.bak
exports/
data-exports/
imports/
uploads/

# ── Dependencies ───────────────────────────────────────────────────────
node_modules/
.npm/

# ── Build output ───────────────────────────────────────────────────────
dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts

# ── Tests & coverage ───────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
blob-report/
.vitest/

# ── Logs & runtime ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pids/
*.pid

# ── Tooling / OS ───────────────────────────────────────────────────────
.turbo/
.cache/
.eslintcache
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Claude Code local state ────────────────────────────────────────────
.claude/settings.local.json
CLAUDE.local.md
