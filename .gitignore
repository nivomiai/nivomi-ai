# ── Secrets & environment ──────────────────────────────────────────────
# Only *.env.example files may be committed. Everything else is local or
# injected by the deployment platform's secret manager.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Keys, certificates, credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
secrets/
.secrets/

# Customer / production data must never enter Git
*.dump
*.sql.gz
*.bak
exports/
data-exports/
imports/
uploads/
recordings/
transcripts/
# ...but source code named after those domains is not data
!apps/api/src/imports/
!apps/web/app/app/data-sources/imports/
*.sqlite
*.sqlite3
*.db

# Infrastructure-as-code state and local cloud config (state files embed secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
cdk.out/
.aws/

# ── Dependencies ───────────────────────────────────────────────────────
node_modules/
.npm/
*.tgz

# ── Build output ───────────────────────────────────────────────────────
dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts

# ── Tests & coverage ───────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
blob-report/
.vitest/

# ── Logs & runtime ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pids/
*.pid

# ── Tooling / OS ───────────────────────────────────────────────────────
.turbo/
.cache/
.eslintcache
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Claude Code local state ────────────────────────────────────────────
.claude/settings.local.json
CLAUDE.local.md

# Local development data (embedded PostgreSQL, dev mailbox)
.data/
