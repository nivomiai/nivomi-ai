# Copy to apps/web/.env.local for local development. Never commit real values.

# Where Next forwards /api/v1/* in development and e2e. Leave unset in production: the load
# balancer routes /api/v1/* to the API service. Use 127.0.0.1 (the API binds IPv4).
NIVOMI_API_ORIGIN=http://127.0.0.1:4000

# Marketing-only hosting with no API behind it (e.g. a Vercel preview): set to 1 at build time and
# /login, /signup, /app/* … redirect to the homepage contact section. Leave unset everywhere else.
# NIVOMI_SITE_ONLY=1
