# Copy to apps/api/.env.local for local development. Never commit real values.
# Production values are injected by the deployment platform's secret manager;
# env files are ignored when NODE_ENV=production.

# development | test | production (required)
NODE_ENV=development

HOST=0.0.0.0
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Comma-separated browser origins allowed to call the API.
# Required in production; defaults to http://localhost:3000 otherwise.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Release identifier reported by the health endpoint (set by CI/CD, e.g. the git SHA)
APP_VERSION=

# Trust exactly one proxy hop (the load balancer) for client IPs. true behind the ALB.
TRUST_PROXY=false

# ── Database ────────────────────────────────────────────────────────────
# PostgreSQL (RDS) connection string. Required in production. When unset, development uses an
# embedded PostgreSQL (PGlite) stored in DATABASE_PGLITE_DIR ("memory" = in-memory, lost on exit).
DATABASE_URL=
DATABASE_PGLITE_DIR=.data/pglite
DATABASE_POOL_SIZE=10
# Apply migrations on start. Defaults to true outside production; production runs them as a
# separate deploy step.
DATABASE_AUTO_MIGRATE=

# ── Authentication (ADR-018) ────────────────────────────────────────────
# HS256 signing secret for access tokens, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=
# The previous secret during a rotation (tokens signed with it stay valid until they expire).
AUTH_JWT_PREVIOUS_SECRET=
# Cookie domain, only if the web app and API are on different subdomains. Usually empty.
AUTH_COOKIE_DOMAIN=

# Public URL of the web app, used in email links. Required in production.
APP_WEB_URL=http://localhost:3000

# ── Email (ADR-015) ─────────────────────────────────────────────────────
# dev-mailbox writes emails as JSON files to EMAIL_DEV_MAILBOX_DIR (refused in production).
EMAIL_PROVIDER=dev-mailbox
EMAIL_FROM=Nivomi AI <no-reply@nivomi.ai>
EMAIL_DEV_MAILBOX_DIR=.data/mailbox

# Public demo deployment only (free-tier host before AWS): lets NODE_ENV=production use the
# dev mailbox, local storage and simulated calls/LLM. Never on real customer data. See render.yaml.
DEMO_MODE=false

# Run the background job worker in this process.
WORKER_ENABLED=true

# ── File storage (StorageProvider) ──────────────────────────────────────
# local writes uploaded import files to STORAGE_LOCAL_DIR (development only; refused in
# production). s3 (ap-south-1, SSE-KMS) is not implemented yet.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/uploads

# ── Stored provider credentials ─────────────────────────────────────────
# 32 random bytes, base64, used to encrypt CRM tokens at rest (AES-256-GCM). Required in
# production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=
# The previous key during a rotation (still used to decrypt).
CREDENTIALS_ENCRYPTION_PREVIOUS_KEY=

# ── External CRM adapter (NOT IN MVP) ───────────────────────────────────
# External CRM integrations are not in the Nivomi MVP (owner decision 2026-10-06). The HubSpot
# adapter stays as a reference implementation of the CRMProvider seam. Leave both empty.
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# ── Voice (STT + TTS) ───────────────────────────────────────────────────
# Sarvam AI subscription key. Powers /demo/voice today and the real STT/TTS during a call once
# the Sarvam streaming adapter lands. Unset = demo canned transcript + browser Web Speech API.
SARVAM_API_KEY=
# Chat model id used by the voice demo. Change if sarvam-m returns a model-not-found error.
SARVAM_CHAT_MODEL=sarvam-m

# ── Language model (AI Agents) ─────────────────────────────────────────
# Anthropic Claude API key. Required when LLM_PROVIDER=anthropic. Leave blank until the
# AnthropicLLMProvider adapter is in and you want the agent to use the real model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# simulated | anthropic. simulated is refused in production.
LLM_PROVIDER=simulated

# ── Calling (Exotel, ADR-021) ───────────────────────────────────────────
# simulated is the only dialer today; the Exotel adapter is Phase-4 work and will accept
# VOICE_PROVIDER=exotel. Both simulated dialer and preference registry are refused in production.
VOICE_PROVIDER=simulated
VOICE_SIMULATED_CALL_MS=2000
PREFERENCE_REGISTRY=simulated
# Fill these in when the Exotel account is live. Required if VOICE_PROVIDER=exotel.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_WEBHOOK_SECRET=
# Exotel API host; override only for sandbox / non-India tenants.
EXOTEL_API_URL=https://api.exotel.com
