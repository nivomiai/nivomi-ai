{
  "name": "@nivomi/api",
  "version": "0.0.0",
  "private": true,
  "description": "Nivomi AI HTTP API (NestJS modular monolith)",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.js",
    "start": "node dist/main.js",
    "db:seed:dev": "tsc -p tsconfig.build.json && node dist/dev/seed.main.js",
    "exotel:probe": "node scripts/exotel-probe.mjs",
    "exotel:test-call": "node scripts/exotel-test-call.mjs",
    "exotel:inbound-demo": "node scripts/exotel-inbound-demo.mjs",
    "ngrok:tail": "node scripts/ngrok-tail.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run test/",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nivomi/config": "0.0.0",
    "@nivomi/database": "0.0.0",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.15",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "read-excel-file": "9.3.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "1.16.18",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
