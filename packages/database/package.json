{
  "name": "@nivomi/database",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema, migrations and client (Drizzle; pg in production, PGlite for dev and tests)",
  "type": "module",
  "exports": {
    ".": {
      "@nivomi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "db:generate": "drizzle-kit generate",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.3"
  }
}
